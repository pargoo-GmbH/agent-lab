{
  "name": "pargoo-agent-lab",
  "interface": {
    "displayName": "pargoo Agent Lab"
  },
  "plugins": [
    {
      "name": "pargoo-devflow",
      "source": {
        "source": "local",
        "path": "./plugins/pargoo-devflow"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "strapi-editor",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/pargoo-GmbH/agent-lab.git",
        "ref": "stable",
        "path": "./packages/strapi-editor"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
