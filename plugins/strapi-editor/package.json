{
  "name": "strapi-editor",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "A local, multi-project Strapi editor plugin for Codex Desktop on macOS",
  "engines": {
    "node": "22.21.1"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "release": "node scripts/release.ts",
    "check": "node scripts/check.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "dev": "node scripts/dev.ts",
    "start": "./dist/runtime/node ./dist/server/index.mjs",
    "check:desktop": "node scripts/check.ts --desktop",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix && prettier . --write",
    "format:check": "prettier . --check",
    "version:set": "node scripts/release.ts --version"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
